{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    // ── 1. Secretos: la IA no los lee ni los escribe ────────────────────
    { "action": "read", "resource": "*.env",           "effect": "deny" },
    { "action": "read", "resource": "*.env.*",         "effect": "deny" },
    { "action": "read", "resource": "*.pem",           "effect": "deny" },
    { "action": "read", "resource": "*.key",           "effect": "deny" },
    { "action": "read", "resource": "*.p8",            "effect": "deny" },
    { "action": "read", "resource": "*.p12",           "effect": "deny" },
    { "action": "read", "resource": "*.keystore",      "effect": "deny" },
    { "action": "read", "resource": "*.jks",           "effect": "deny" },
    { "action": "read", "resource": "*firebase-adminsdk*.json", "effect": "deny" },
    { "action": "read", "resource": "*serviceaccount*.json",    "effect": "deny" },

    { "action": "edit", "resource": "*.env",         "effect": "deny" },
    { "action": "edit", "resource": "*.env.*",       "effect": "deny" },
    { "action": "edit", "resource": "*.pem",         "effect": "deny" },
    { "action": "edit", "resource": "*.key",         "effect": "deny" },
    { "action": "edit", "resource": "*.keystore",    "effect": "deny" },
    { "action": "edit", "resource": "*.jks",         "effect": "deny" },

    // ── 2. Cárcel de directorios: nada fuera del repo ───────────────────
    { "action": "external_directory", "resource": "*",    "effect": "deny" },
    { "action": "read",  "resource": "../*",              "effect": "deny" },
    { "action": "edit",  "resource": "../*",              "effect": "deny" },
    { "action": "glob",  "resource": "../*",              "effect": "deny" },
    { "action": "glob",  "resource": "/*",                "effect": "deny" },

    // ── 3. La IA no modifica su propia jaula ────────────────────────────
    { "action": "edit", "resource": ".opencode/**",    "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc",  "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md",       "effect": "deny" },

    // ── 4. Shell: todo pide permiso, lo peligroso está denegado ─────────
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Inspección segura (no modifica nada)
    { "action": "shell", "resource": "git status *",  "effect": "allow" },
    { "action": "shell", "resource": "git diff *",    "effect": "allow" },
    { "action": "shell", "resource": "git log *",     "effect": "allow" },
    { "action": "shell", "resource": "git show *",    "effect": "allow" },
    { "action": "shell", "resource": "ls",            "effect": "allow" },
    { "action": "shell", "resource": "ls *",          "effect": "allow" },
    { "action": "shell", "resource": "npm run check", "effect": "allow" },
    { "action": "shell", "resource": "npm run test *","effect": "allow" },
    { "action": "shell", "resource": "npm run lint *","effect": "allow" },
    { "action": "shell", "resource": "npx tsc *",     "effect": "allow" },
    { "action": "shell", "resource": "npm run check:ia", "effect": "allow" },

    // Acciones con efecto fuera de la máquina: preguntan
    { "action": "shell", "resource": "git push *",          "effect": "ask" },
    { "action": "shell", "resource": "git commit *",        "effect": "ask" },
    { "action": "shell", "resource": "npm install *",       "effect": "ask" },
    { "action": "shell", "resource": "npm i *",             "effect": "ask" },
    { "action": "shell", "resource": "npx expo install *",  "effect": "ask" },
    { "action": "shell", "resource": "npx create-expo-app *", "effect": "ask" },
    { "action": "shell", "resource": "eas *",               "effect": "ask" },
    { "action": "shell", "resource": "vercel *",            "effect": "ask" },
    { "action": "shell", "resource": "npx expo start *",    "effect": "ask" },

    // Denegado siempre (van al final: gana la última regla que coincide)
    { "action": "shell", "resource": "sudo *",            "effect": "deny" },
    { "action": "shell", "resource": "* sudo *",          "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf*",          "effect": "deny" },
    { "action": "shell", "resource": "*rm -fr*",          "effect": "deny" },
    { "action": "shell", "resource": "curl *",            "effect": "deny" },
    { "action": "shell", "resource": "*curl *",           "effect": "deny" },
    { "action": "shell", "resource": "wget *",            "effect": "deny" },
    { "action": "shell", "resource": "*wget *",           "effect": "deny" },
    { "action": "shell", "resource": "*| sh",             "effect": "deny" },
    { "action": "shell", "resource": "*| bash",           "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*",      "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -*",      "effect": "deny" },
    { "action": "shell", "resource": "cat *.env*",        "effect": "deny" },
    { "action": "shell", "resource": "head *.env*",       "effect": "deny" },
    { "action": "shell", "resource": "tail *.env*",       "effect": "deny" },
    { "action": "shell", "resource": "grep -r *.env*",    "effect": "deny" },
    { "action": "shell", "resource": "*>.env*",           "effect": "deny" },
    { "action": "shell", "resource": "env",               "effect": "deny" },
    { "action": "shell", "resource": "printenv *",        "effect": "deny" },
    { "action": "shell", "resource": "vercel env *",      "effect": "deny" },
    { "action": "shell", "resource": "@google-cloud/*",   "effect": "deny" },

    // ── 5. Red: solo documentación y registro de paquetes ───────────────
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "https://registry.npmjs.org/*",       "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.npmjs.com/*",            "effect": "allow" },
    { "action": "webfetch", "resource": "https://github.com/*",               "effect": "allow" },
    { "action": "webfetch", "resource": "https://raw.githubusercontent.com/*","effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.expo.dev/*",            "effect": "allow" },
    { "action": "webfetch", "resource": "https://reactnative.dev/*",          "effect": "allow" },
    { "action": "webfetch", "resource": "https://opencode.ai/*",              "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.mozilla.org/*",    "effect": "allow" },
    { "action": "webfetch", "resource": "https://firebase.google.com/*",      "effect": "allow" },
    { "action": "webfetch", "resource": "https://vitest.dev/*",               "effect": "allow" },
    { "action": "webfetch", "resource": "https://eslint.org/*",               "effect": "allow" },
    { "action": "webfetch", "resource": "https://prettier.io/*",              "effect": "allow" },
    { "action": "webfetch", "resource": "https://zod.dev/*",                  "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ]
}